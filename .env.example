# 听己 · 部署设置。复制为 .env，填好第一项即可启动：docker compose up -d
# 改完设置执行 docker compose up -d 生效。

# ---------- 必填 ----------
# 你的音乐文件夹在 NAS 上的路径
TINGJI_MUSIC_DIR=/vol1/1000/音乐

# ---------- 常用（可不改） ----------
# 网页端口：浏览器打开 http://NAS的IP:18000
TINGJI_WEB_PORT=18000
# 音屿连接用的设备端口
TINGJI_NATIVE_PORT=18001
# 让音屿在家里直连：填 http://NAS的局域网IP:上面的设备端口；不用音屿可留空
TINGJI_NATIVE_LAN_URL=
# 曲库读写：rw 可写（下载入库、改标签、整理都要写入，均需在网页确认且可撤销）；ro 只读
TINGJI_MUSIC_MODE=rw
# 容器以此用户运行，data 与 models 目录要属于它（在 NAS 上执行 id 查看）
PUID=1000
PGID=1000
TZ=Asia/Shanghai

# ---------- 外网访问（有自己的域名和 HTTPS 反向代理时再填） ----------
# 网页的外网地址，例如 https://tingji.example.com
TINGJI_PUBLIC_URL=
# 音屿在外面也能连：设备接口的外网 HTTPS 地址，例如 https://tjapi.example.com
TINGJI_NATIVE_PUBLIC_URL=
# 同一实例的其他网页地址（第二个域名等），逗号分隔
TINGJI_ALTERNATE_PUBLIC_URLS=
TINGJI_NATIVE_ALTERNATE_PUBLIC_URLS=
# 反向代理所在机器的 IP（逗号分隔）；只有它们转发的 HTTPS 标记会被采信
TINGJI_TRUSTED_PROXY_IPS=
# 1：用任何地址打开都能用（写操作仍核对来源）；0：只认上面登记的地址
TINGJI_ALLOW_ANY_HOST=1

# ---------- 资源 ----------
# 分析用的 CPU 核数、线程数与内存上限，按 NAS 配置调整
TINGJI_CPUS=2
TINGJI_ANALYSIS_THREADS=2
TINGJI_MEMORY=4g
# 1：允许在网页里一键下载分析模型（约 1.3 GB）；0：只能离线导入
TINGJI_ALLOW_MODEL_DOWNLOADS=1

# ---------- 目录与版本（一般不改） ----------
TINGJI_DATA_DIR=./data
TINGJI_MODELS_DIR=./models
TINGJI_IMAGE=666uos/songlib-muse:0.6.33
